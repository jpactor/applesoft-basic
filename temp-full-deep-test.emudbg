profile pocket2e-a2-enh
# ensure clean
reset
# boot the prodos disk (in slot 6 by profile)
boot --immediate
# wait for boot to complete to BASIC.SYSTEM prompt; use steps and checks
step 10000
screen --json
peek $0400 80
regs
# verify prompt by looking for BASIC.SYSTEM or ]
# now create second disk on 6:2
disk create prodos d2.po --size 140k --format prodos
disk insert 6:2 d2.po
disk fsinfo 6:2 --json
# now input the demo.bas via keyboard
keyboard type 'NEW\n'
keyboard type '10 HOME\n'
keyboard type '20 PRINT "DEMO TEST"\n'
keyboard type '30 FOR I=1 TO 5\n'
keyboard type '40 PRINT I;" HELLO FROM PRODOS"\n'
keyboard type '50 NEXT I\n'
keyboard type '60 END\n'
keyboard type 'LIST\n'
# run it
keyboard type 'RUN\n'
step 100
screen --json
# save to D2
keyboard type 'SAVE /RAM/DEMO\n'   # or PREFIX and save, use volume if needed
step 50
disk ls 6:2 --json
# new load run
keyboard type 'NEW\n'
keyboard type 'LIST\n'
keyboard type 'LOAD /RAM/DEMO\n'
keyboard type 'LIST\n'
keyboard type 'RUN\n'
step 100
screen --json
# verify fs
disk fsinfo 6:1 --json
disk fsinfo 6:2 --json
disk ls 6:2
# perf
perf --json
regs
exit