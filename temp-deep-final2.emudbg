disk insert 6:1 library://disks/prodos203-master.dsk
boot --immediate
run --timeout=12000 --until-cycles=3000000
pause
video screen --json
peek $0400 80
disk fsinfo 6:1 --json
disk create C:/Users/joshp/temp-prodos-d2.dsk --format prodos --volume-name TESTVOL
disk insert 6:2 C:/Users/joshp/temp-prodos-d2.dsk
disk fsinfo 6:2 --json
keyboard type "NEW\r"
run --timeout=100
pause
keyboard type "10 REM APPLESOFT BASIC DEMO PROGRAM\r20 REM DEMONSTRATES VARIOUS FEATURES\r30 HOME\r40 PRINT \"APPLESOFT BASIC INTERPRETER\"\r50 PRINT \"==========================\"\r60 PRINT\r"
run --timeout=100
pause
keyboard type "100 REM BASIC ARITHMETIC\r110 PRINT \"BASIC ARITHMETIC:\"\r120 PRINT \"2 + 3 * 4 = \";2+3*4\r130 PRINT \"10 / 3 = \";10/3\r140 PRINT \"2 ^ 10 = \";2^10\r"
run --timeout=100
pause
keyboard type "950 PRINT \"DEMO COMPLETE!\"\r960 END\r"
run --timeout=100
pause
keyboard type "LIST\r"
run --timeout=300
pause
video screen --json
keyboard type "RUN\r"
run --timeout=3000
pause
video screen --json
keyboard type "SAVE DEMO,D2\r"
run --timeout=1000
pause
disk-ls 6:2 --json
keyboard type "NEW\r"
run --timeout=100
pause
keyboard type "LOAD DEMO,D2\r"
run --timeout=1000
pause
video screen --json
keyboard type "LIST\r"
run --timeout=300
pause
video screen --json
keyboard type "RUN\r"
run --timeout=3000
pause
video screen --json
disk-ls 6:2
perf --json
exit
