disk insert 6:1 library://disks/prodos203-master.dsk
disk fsinfo 6:1 --json
disk-ls 6:1 --json
boot --immediate
run --timeout=10000 --until-cycles=2000000
pause
perf --json
video screen --json
peek $0400 80
disk create C:/Users/joshp/temp-prodos-d2.dsk --format prodos --volume-name TESTVOL
disk insert 6:2 C:/Users/joshp/temp-prodos-d2.dsk
disk fsinfo 6:2 --json
disk-ls 6:2 --json
keyboard type "NEW\r"
run --timeout=100
pause
keyboard type "10 REM APPLESOFT BASIC DEMO PROGRAM\r20 REM DEMONSTRATES VARIOUS FEATURES\r30 HOME\r40 PRINT \"APPLESOFT BASIC INTERPRETER\"\r50 PRINT \"============================\"\r60 PRINT\r"
run --timeout=100
pause
keyboard type "\r100 REM BASIC ARITHMETIC\r110 PRINT \"BASIC ARITHMETIC:\"\r120 PRINT \"2 + 3 * 4 = \"; 2 + 3 * 4\r130 PRINT \"10 / 3 = \"; 10 / 3\r140 PRINT \"2 ^ 10 = \"; 2 ^ 10\r"
run --timeout=100
pause
keyboard type "150 PRINT\r\r200 REM FOR-NEXT LOOPS\r210 PRINT \"FOR-NEXT LOOP (1 TO 5):\"\r220 FOR I = 1 TO 5\r230 PRINT I; \" \";\r"
run --timeout=100
pause
keyboard type "240 NEXT I\r250 PRINT\r260 PRINT\r\r300 REM STRING FUNCTIONS\r310 PRINT \"STRING FUNCTIONS:\"\r"
run --timeout=100
pause
keyboard type "320 A$ = \"HELLO WORLD\"\r330 PRINT \"A$ = \"; A$\r340 PRINT \"LEN(A$) = \"; LEN(A$)\r350 PRINT \"LEFT$(A$,5) = \"; LEFT$(A$, 5)\r360 PRINT \"RIGHT$(A$,5) = \"; RIGHT$(A$, 5)\r370 PRINT \"MID$(A$,7,5) = \"; MID$(A$, 7, 5)\r"
run --timeout=100
pause
keyboard type "380 PRINT\r\r400 REM MATH FUNCTIONS\r410 PRINT \"MATH FUNCTIONS:\"\r420 PRINT \"SIN(3.14159/2) = \"; SIN(3.14159 / 2)\r430 PRINT \"COS(0) = \"; COS(0)\r"
run --timeout=100
pause
keyboard type "440 PRINT \"SQR(144) = \"; SQR(144)\r450 PRINT \"ABS(-42) = \"; ABS(-42)\r460 PRINT \"INT(3.7) = \"; INT(3.7)\r470 PRINT\r\r500 REM ARRAYS\r"
run --timeout=100
pause
keyboard type "510 PRINT \"ARRAYS:\"\r520 DIM B(5)\r530 FOR I = 1 TO 5\r540 B(I) = I * I\r550 NEXT I\r560 PRINT \"B(1) TO B(5): \";\r"
run --timeout=100
pause
keyboard type "570 FOR I = 1 TO 5\r580 PRINT B(I); \" \";\r590 NEXT I\r600 PRINT\r610 PRINT\r\r"
run --timeout=100
pause
keyboard type "700 REM DATA/READ\r710 PRINT \"DATA/READ:\"\r720 DATA 10, 20, 30, 40, 50\r730 S = 0\r740 FOR I = 1 TO 5\r750 READ X\r"
run --timeout=100
pause
keyboard type "760 S = S + X\r770 NEXT I\r780 PRINT \"SUM OF DATA: \"; S\r790 PRINT\r\r800 REM USER-DEFINED FUNCTIONS\r"
run --timeout=100
pause
keyboard type "810 PRINT \"USER-DEFINED FUNCTIONS:\"\r820 DEF FN CUBE(X) = X * X * X\r830 PRINT \"FN CUBE(3) = \"; FN CUBE(3)\r840 PRINT \"FN CUBE(4) = \"; FN CUBE(4)\r850 PRINT\r\r"
run --timeout=100
pause
keyboard type "900 REM GOSUB/RETURN\r910 PRINT \"GOSUB/RETURN:\"\r920 GOSUB 1000\r930 PRINT \"RETURNED FROM SUBROUTINE\"\r940 PRINT\r\r"
run --timeout=100
pause
keyboard type "950 PRINT \"DEMO COMPLETE!\"\r960 END\r\r1000 REM SUBROUTINE\r1010 PRINT \"INSIDE SUBROUTINE\"\r1020 RETURN\r"
run --timeout=100
pause
keyboard type "LIST\r"
run --timeout=400
pause
video screen --json
keyboard type "RUN\r"
run --timeout=3000
pause
video screen --json
keyboard type "SAVE DEMO,D2\r"
run --timeout=1000
pause
disk-ls 6:2 --json
keyboard type "NEW\r"
run --timeout=100
pause
keyboard type "LOAD DEMO,D2\r"
run --timeout=1000
pause
video screen --json
keyboard type "LIST\r"
run --timeout=300
pause
video screen --json
keyboard type "RUN\r"
run --timeout=3000
pause
video screen --json
disk-ls 6:2
perf --json
exit
