disk insert 6:1 library://disks/prodos203-master.dsk
disk fsinfo 6:1 --json
disk-ls 6:1 --json
boot --immediate
run --timeout=10000 --until-cycles=2000000
pause
perf --json
video screen --json
peek $0400 80
disk create C:/Users/joshp/temp-prodos-d2.dsk --format prodos --volume-name TESTVOL
disk insert 6:2 C:/Users/joshp/temp-prodos-d2.dsk
disk fsinfo 6:2 --json
disk-ls 6:2 --json
keyboard type "NEW\r"
run --timeout=100
pause
keyboard type "10 REM DEMO\r20 PRINT \"HELLO FROM D2\"\r30 END\r"
run --timeout=100
pause
keyboard type "LIST\r"
run --timeout=200
pause
keyboard type "RUN\r"
run --timeout=1000
pause
video screen --json
keyboard type "SAVE DEMO,D2\r"
run --timeout=800
pause
disk-ls 6:2 --json
keyboard type "NEW\r"
run --timeout=100
pause
keyboard type "LOAD DEMO,D2\r"
run --timeout=800
pause
keyboard type "RUN\r"
run --timeout=1000
pause
video screen --json
disk-ls 6:2
perf --json
exit
